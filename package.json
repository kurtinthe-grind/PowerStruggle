{
    "name": "power-struggle",
    "version": "0.49.0",
    "private": true,
    "description": "Crysis-inspired Power Struggle mode for Battlefield 6 Portal",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "bundle": "bf6-portal-bundler --entrypoint ./src/index.ts --outDir ./dist",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "verify:bundle": "tsc --noEmit -p tsconfig.bundle.json",
        "guard:sources": "node scripts/guard-sources.js",
        "test:guard": "node scripts/test-guard.js",
        "build": "npm run guard:sources && npm run test:winner && npm run test:rorsch && npm run test:raygeom && npm run test:botscore && npm run typecheck && npm run bundle && npm run verify:bundle",
        "test:winner": "node scripts/test-winner.js",
        "test:rorsch": "node scripts/test-rorsch.js",
        "test:raygeom": "node scripts/test-raygeom.js",
        "test:botscore": "node scripts/test-botscore.js"
    },
    "devDependencies": {
        "bf6-portal-bundler": "1.4.1",
        "bf6-portal-utils": "file:../main_resources/bf6-portal-utils-master"
    }
}
